{
  "name": "Originals Fairness Infrastructure",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "forwardPorts": [5173, 3737],
  "portsAttributes": {
    "5173": { "label": "Vite Dev Server", "onAutoForward": "openBrowser" },
    "3737": { "label": "Express API Bridge", "onAutoForward": "notify" }
  },
  "postCreateCommand": "npm ci && pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-python.python"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "typescript.preferences.importModuleSpecifier": "non-relative"
      }
    }
  },
  "containerEnv": {
    "HASHES_API_KEY": "${localEnv:HASHES_API_KEY}",
    "SMTP_ENDPOINT": "${localEnv:SMTP_ENDPOINT}",
    "ALERT_RECIPIENT_EMAIL": "${localEnv:ALERT_RECIPIENT_EMAIL}"
  }
}
