{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "../scripts/**/*.ts",
    "../src/db/**/*.ts",
    "../src/utils/**/*.ts",
    "../src/lib/types.ts"
  ]
}
