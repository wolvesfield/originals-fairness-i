# =============================================================================
# Provably Fair — Environment template (copy to .env; never commit .env)
# =============================================================================

# --- GITHUB (Enterprise SSO — GHEC Cloud) ------------------------------------
# Fine-grained PAT; scopes: repo, read:org, read:enterprise
GITHUB_ENTERPRISE_TOKEN=github_pat_REPLACE_ME
GITHUB_API_URL=https://api.github.com
GITHUB_ORG_NAME=your-enterprise-org-slug

# --- DATABASE (Direct API) ---------------------------------------------------
SUPABASE_API_KEY=REPLACE_ME

# --- AI / SEARCH -------------------------------------------------------------
TAVILY_API_KEY=REPLACE_ME
MEM0_API_KEY=REPLACE_ME
ANTHROPIC_API_KEY=REPLACE_ME
OPENROUTER_API_KEY=REPLACE_ME

# --- BLOCKCHAIN --------------------------------------------------------------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ALCHEMY_API_KEY=REPLACE_ME
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/REPLACE_ME

# --- STAKE -------------------------------------------------------------------
STAKE_AUTH_TOKEN=REPLACE_ME
STAKE_SECRET=REPLACE_ME
STAKE_X_ACCESS_TOKEN=REPLACE_ME

# --- HASHES ------------------------------------------------------------------
HASHES_API_KEY=REPLACE_ME

# --- RINPOD ------------------------------------------------------------------
RINPOD_API_KEY=REPLACE_ME
RINPOD_SECRET=REPLACE_ME

# --- S3 / STORAGE ------------------------------------------------------------
S3_USER_ACCESS_KEY=REPLACE_ME

# --- WISE --------------------------------------------------------------------
WISE_API_KEY=REPLACE_ME

# --- API 200 -----------------------------------------------------------------
API200_KEY=REPLACE_ME

# --- BANKING (Canada Direct Debits, optional) ---------------------------------
# BANK_INSTITUTION_NUMBER=
# BANK_ACCOUNT_NUMBER=
# BANK_TRANSIT_NUMBER=
# BANK_NAME=
# BANK_ADDRESS=

# --- KRAKEN ------------------------------------------------------------------
# KRAKEN_API_KEY=
# KRAKEN_PRIVATE_KEY=
# KRAKEN_PUBLIC_ID=

# --- CLOUDFLARE --------------------------------------------------------------
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# --- CLOUD FAIR WORKER (CORS proxy) ------------------------------------------
CLOUDFAIR_WORKER_API_TOKEN=REPLACE_ME
CLOUDFAIR_WORKER_BASE_URL=https://your-cors-proxy.workers.dev/?url=

# --- CONTAINER / KUBERNETES (optional) ---------------------------------------
# KUBECONFIG=/absolute/path/to/.kube/config

# --- MCP: SERENA DESKTOP COMMANDER & MEMORY ---------------------------------
# SERENA_DESKTOP_COMMANDER_URL=
# MEMORY_MCP_API_KEY=
