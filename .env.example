# Provably Fair Statistical Integrity Suite — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit real keys to .env.example

# Core APIs
HASHES_API_KEY=your_hashes_com_api_key_here
STAKE_AUTH_TOKEN=your_stake_auth_token_here
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
CASINO_CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS_HERE
# Alert Configuration (Discord + Email)
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
SMTP_ENDPOINT=your_smtp_api_endpoint_here
ALERT_RECIPIENT_EMAIL=your_email@example.com
ALERT_SENDER_EMAIL=fairness-suite@localhost

# Optional Integrations
TAVILY_API_KEY=your_tavily_api_key_here
MEM0_API_KEY=your_mem0_api_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
GITHUB_FINE_GRAINED_PAT=your_github_pat_here

# Rate Limiting / Worker Controls
HASHES_API_RATE_LIMIT=100
MAX_CONCURRENT_WORKERS=4
MONTE_CARLO_ITERATIONS=50000